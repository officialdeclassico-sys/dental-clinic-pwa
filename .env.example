# Optional Vite Development Settings
# Set to "true" to disable Hot Module Replacement (HMR) and file watching.
DISABLE_HMR=false

# ---------------------------------------------------------------------------
# Notes for Future Integrations
# ---------------------------------------------------------------------------
# This frontend application runs completely client-side with no required API keys.
# If you connect a backend API or client SDK in the future:
# 1. Vite only exposes variables prefixed with `VITE_` to browser code.
# 2. NEVER store private secrets, database credentials, or admin keys in `VITE_*`
#    variables, because client-side environment variables are bundled into public JS.
# ---------------------------------------------------------------------------
